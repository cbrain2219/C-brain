NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public HTTPS admin app origin used by AlimTalk detail buttons.
ADMIN_APP_URL=
# Optional public HTTPS user app origin for payment AlimTalk buttons.
# Falls back to NEXT_PUBLIC_SITE_URL in deployed environments.
PAYMENT_ALIMTALK_USER_APP_URL=

# POPBiLL Kakao AlimTalk
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
POPBILL_CORP_NUM=
# Popbill API sandbox setting; the admin phone is selected by VERCEL_ENV.
POPBILL_IS_TEST=true
POPBILL_ADMIN_PHONE_DEV=
POPBILL_ADMIN_PHONE_LIVE=
POPBILL_TEMPLATE_AUTH_CODE=
POPBILL_TEMPLATE_COMPLAINT=
POPBILL_TEMPLATE_PAYMENT_ADMIN=
POPBILL_TEMPLATE_PAYMENT_USER=
