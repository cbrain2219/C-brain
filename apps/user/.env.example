NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Local/test override. Production canonical URLs always use https://www.cbrain.kr.
NEXT_PUBLIC_SITE_URL=https://www.cbrain.kr
# Exact browser origin allowed to call the admin payment APIs (no trailing slash).
# Complaint AlimTalk detail buttons require this to be a public HTTPS origin.
ADMIN_APP_URL=http://localhost:5173
# Public HTTPS user app origin used by payment AlimTalk detail buttons.
PAYMENT_ALIMTALK_USER_APP_URL=

# NICEPAY: sandbox | production
NICEPAY_MODE=sandbox
NEXT_PUBLIC_NICEPAY_CLIENT_KEY=
NICEPAY_SECRET_KEY=

# POPBiLL Kakao AlimTalk
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
POPBILL_CORP_NUM=
# Popbill API sandbox setting; the admin phone is selected by VERCEL_ENV.
POPBILL_IS_TEST=true
POPBILL_ADMIN_PHONE_DEV=
POPBILL_ADMIN_PHONE_LIVE=
POPBILL_TEMPLATE_AUTH_CODE=
POPBILL_TEMPLATE_COMPLAINT=
POPBILL_TEMPLATE_PAYMENT_ADMIN=
POPBILL_TEMPLATE_PAYMENT_USER=
