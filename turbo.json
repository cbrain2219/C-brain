{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "ADMIN_APP_URL",
    "NICEPAY_MODE",
    "NICEPAY_SECRET_KEY",
    "NEXT_PUBLIC_NICEPAY_CLIENT_KEY",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL",
    "NEXT_PUBLIC_VERCEL_URL",
    "PAYMENT_ALIMTALK_USER_APP_URL",
    "POPBILL_ADMIN_PHONE_DEV",
    "POPBILL_ADMIN_PHONE_LIVE",
    "POPBILL_CORP_NUM",
    "POPBILL_IS_TEST",
    "POPBILL_LINK_ID",
    "POPBILL_SECRET_KEY",
    "POPBILL_TEMPLATE_AUTH_CODE",
    "POPBILL_TEMPLATE_COMPLAINT",
    "POPBILL_TEMPLATE_PAYMENT_ADMIN",
    "POPBILL_TEMPLATE_PAYMENT_USER",
    "VERCEL_ENV",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
